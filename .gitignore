# Python 缓存（字节码里会嵌入本机绝对路径）
__pycache__/
*.pyc
*.pyo

# 运行时产生的文件
tray_pid.txt
tray_debug.log
_dbg*.txt
_hidcap.log

# 个人设置（刷新间隔 / 开机自启开关）
tray_config.json

# 本地生成的快捷方式
*.lnk

# 打包相关
.venv/
build/
dist/
tools/_icon_preview/

# 本地生成/临时产物（生成的图标、预览图、临时脚本）
tools/_*.png
tools/preview_*.png
tests/_*_tmp.py

# Agent 工作记录
.workbuddy/
.workbuddy-ai/

# 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
desktop.ini
